'''
Цель: закрепить навык написания функций и их вызовов.
Задача "Матрица воплоти":
Напишите функцию get_matrix с тремя параметрами n, m и value, которая будет создавать матрицу(вложенный список) размерами n строк и m столбцов, заполненную значениями value и возвращать эту матрицу в качестве результата работы.
'''
def get_matrix(n,m,value):
	ma=[]	#создаем пустой список
	for i in range(n):	#цикл по строкам
		ma.append([])	#добавляем очередную строку
		for j in range(m):
			ma[i].append(value)	# заполняем строку значениями
	return ma

print('0,7,35 :', get_matrix(0,7,35)) #пустой список
print('0,0,35 :', get_matrix(0,0,35)) #пустой список
print('3,0,35 :', get_matrix(3,0,35)) #список из трёх пустых списков

# тестовые значения
result1 = get_matrix(2, 2, 10)
result2 = get_matrix(3, 5, 42)
result3 = get_matrix(4, 2, 13)
print(result1)
print(result2)
print(result3)
